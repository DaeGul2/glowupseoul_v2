PORT=3001
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_MODEL=gpt-4o-mini
# Allowed origins, comma-separated. * = open (dev only)
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# Cap inbound JSON size — image base64 is the biggest payload
MAX_BODY_MB=8
# Google Places API (New) — for /api/reviews
GOOGLE_PLACES_API_KEY=
REVIEWS_CACHE_HOURS=24
# Admin key for /api/partner/admin listing — long random string
ADMIN_KEY=

# ---- AWS RDS MySQL ----
# RDS endpoint, e.g. glowupseoul-prod.cluster-xxxx.ap-northeast-2.rds.amazonaws.com
DB_HOST=
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
# 운영 = glowupseoul_v3_prod / 개발 = glowupseoul_v3_dev
DB_NAME=glowupseoul_v3_prod
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
# 'rds' = use bundled AWS RDS CA (recommended). 'true' = generic TLS. 'false' = no TLS (dev only).
DB_SSL_MODE=rds
DB_SSL_CA_PATH=

# ---- AWS S3 (image uploads from admin) ----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_MAX_UPLOAD_MB=10

# ---- v3 Booking system ----
# Cloudflare Turnstile secret key (spam guard on POST /api/v3/bookings).
# Empty = verification skipped (dev only — ALWAYS set in production).
TURNSTILE_SECRET_KEY=
# Optional .env fallbacks — normally managed in the admin Settings tab (DB):
# BOOKING_ENABLED=1
# BOOKING_MIN_LEAD_DAYS=3
# BOOKING_MAX_AHEAD_DAYS=180
# Optional notification channels (dormant until keys are set):
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# BOOKING_NOTIFY_EMAIL=
# Public site origin — used in confirmation email links / ICS
# SITE_ORIGIN=https://glowupseoul.com
